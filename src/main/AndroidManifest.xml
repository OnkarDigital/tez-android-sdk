<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tezgateway.sdk">

    <!-- Required permissions for SDK -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declare UPI apps so Intent queries work on Android 11+ (API 30+) -->
    <queries>
        <!-- Google Pay -->
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <!-- PhonePe -->
        <package android:name="com.phonepe.app" />
        <!-- Paytm -->
        <package android:name="net.one97.paytm" />
        <!-- BHIM -->
        <package android:name="in.org.npci.upiapp" />
        <!-- Amazon Pay -->
        <package android:name="in.amazon.mShop.android.shopping" />
        <!-- CRED -->
        <package android:name="com.dreamplug.androidapp" />
    </queries>

    <application>
        <!--
            Transparent host for the checkout sheet. Own theme → works with any host
            app theme. configChanges → rotation / dark-mode switch never restarts it,
            so an in-progress payment is never lost.
        -->
        <activity
            android:name="com.tezgateway.sdk.ui.TezCheckoutActivity"
            android:exported="false"
            android:theme="@style/Theme.TezGateway.Checkout"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize" />

        <!--
            FileProvider for sharing the QR image to GPay. Uses the SDK's own subclass
            (not androidx.core.content.FileProvider) so it can never be merged with —
            and broken by — a FileProvider declared by the host app or another library.
        -->
        <provider
            android:name="com.tezgateway.sdk.utils.TezFileProvider"
            android:authorities="${applicationId}.tezgateway.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/tez_file_paths" />
        </provider>
    </application>
</manifest>
